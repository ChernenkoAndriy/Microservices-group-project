apiVersion: v1
kind: Secret
metadata:
  name: spotty-secrets
type: Opaque
stringData:
  AUTH_DB_PASSWORD: "your_secure_auth_password"
  CATALOG_DB_PASSWORD: "your_secure_catalog_password"
  NOTIFICATION_DB_PASSWORD: "your_secure_notification_password"
  LIBRARY_DB_PASSWORD: "your_secure_library_password"
  STREAMING_DB_PASSWORD: "your_secure_streaming_password"
  CLICKHOUSE_PASSWORD: "your_secure_clickhouse_password"
  MINIO_ROOT_PASSWORD: "your_secure_minio_password"
  INTERNAL_API_TOKEN: "your_secure_internal_api_token"
  # Base64 of at least 32 bytes (auth-service decodes it as an HMAC key); generate one with: openssl rand -base64 48
  AUTH_SERVICE_JWT_SECRET: "c3BvdHR5LWs4cy1qd3Qtc2lnbmluZy1rZXktY2hhbmdlLW1lLWF0LWxlYXN0LTMyLWJ5dGVz"