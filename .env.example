# ==============================================================================
# SPOTTY PLATFORM - ENVIRONMENT VARIABLES TEMPLATE
# Скопіюйте цей файл у .env: cp .env.example .env
# ==============================================================================

# --- 1. Auth Database (PostgreSQL) ---
AUTH_DB_NAME=spotty_auth_db
AUTH_DB_USER=spotty_auth_user
AUTH_DB_PASSWORD=your_secure_auth_password

# --- 2. Catalog Database (PostgreSQL) ---
CATALOG_DB_NAME=spotty_catalog_db
CATALOG_DB_USER=spotty_catalog_user
CATALOG_DB_PASSWORD=your_secure_catalog_password

# --- 3. Media Storage (MinIO S3) ---
MINIO_ROOT_USER=spotty_minio_admin
MINIO_ROOT_PASSWORD=your_secure_minio_password

# --- 4. Analytics Database (ClickHouse) ---
CLICKHOUSE_DB=spotty_analytics_db
CLICKHOUSE_USER=spotty_clickhouse_user
CLICKHOUSE_PASSWORD=your_secure_clickhouse_password

# --- 5. Notifications Database (PostgreSQL) ---
NOTIFICATION_DB_NAME=spotty_notification_db
NOTIFICATION_DB_USER=spotty_notification_user
NOTIFICATION_DB_PASSWORD=your_secure_notification_password

# --- 6. Library Database (PostgreSQL) ---
LIBRARY_DB_NAME=spotty_library_db
LIBRARY_DB_USER=spotty_library_user
LIBRARY_DB_PASSWORD=your_secure_library_password

# --- Public port (only the API Gateway is exposed to the host) ---
GATEWAY_PORT=8080
